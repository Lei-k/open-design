# Multi-user staging deployment. Copy to `.env` next to docker-compose.yml:
#
#   cp .env.example .env
#
# Compose reads `.env` from this directory for every command, `build` included,
# so the two domains below must be set before anything runs.

# The public host users sign in on. Must match `publicOrigin` in multiuser.json
# (same host, https, no path) and resolve to this machine.
OD_DOMAIN=od.example.com

# A SEPARATE host for untrusted generated previews. Must match `previewOrigin`
# in multiuser.json. A different hostname is required, not just a different
# port: host cookies would still be sent to the same host on another port.
OD_PREVIEW_DOMAIN=preview.od.example.com

# Published ports. Caddy needs 80 reachable from the internet for Let's Encrypt
# validation, and 443 for HTTPS (TCP and UDP, the latter for HTTP/3).
OD_HTTP_PORT=80
OD_HTTPS_PORT=443

# Image used when you do not `docker compose build` locally. A build tags the
# image with this same name, so `up` then uses what you built.
OPEN_DESIGN_MULTIUSER_IMAGE=neil0628/open-design:multiuser-latest
CADDY_IMAGE=caddy:2-alpine

# Memory ceiling for the daemon container.
OD_MEM_LIMIT=2g
